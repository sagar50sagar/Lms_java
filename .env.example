PORT=8080
# development | production. With production the app refuses to boot unless JWT_SECRET,
# DB_PASSWORD and FRONTEND_URL are overridden and DEMO_DATA=false.
APP_ENV=development
DEMO_DATA=true
# Set true ONLY behind a reverse proxy you control that writes X-Forwarded-For, and ONLY together with
# FORWARD_HEADERS_STRATEGY=native (or framework). This pair decides what "client IP" means:
#   trust=true + real proxy  -> per-user IP budgets work as documented.
#   trust=true + no proxy    -> anyone can forge X-Forwarded-For and pick any IP budget they like,
#                               so the per-IP rule stops protecting anything at all.
#   trust=false + proxy      -> every visitor presents as the proxy's IP and SHARES one budget, which
#                               turns a handful of typos into a lockout for the whole company.
RATE_LIMIT_TRUST_PROXY=false
FORWARD_HEADERS_STRATEGY=none
DB_URL=jdbc:postgresql://localhost:5432/lms_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
# Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-unique-32-character-minimum-secret
# 7 days is convenient for development; production refuses to start above 12 hours (43200000).
JWT_EXPIRATION=604800000
INITIAL_ADMIN_EMAIL=admin@your-company.example
INITIAL_ADMIN_PASSWORD=change-this-to-a-long-unique-password
INITIAL_ADMIN_FULL_NAME=Initial Administrator
# Must be the public https:// origin users actually reach, or account setup links go to localhost.
# The jar itself only serves plain HTTP, so terminate TLS and set this at the same time on the host.
FRONTEND_URL=http://localhost:8080
# Wrong-password budget: 10 failures lock that account for 5 minutes, 200 lock the client IP for 15 minutes.
# Neither can keep a real user out — a correct password always logs in and clears the counters.
# The IP budget counts login REQUESTS, not people, and one office or mobile network shares one IP.
# Keep it generous enough for a whole floor to log in at 9am with a few typos; it only exists to bound bcrypt CPU.
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_IP_ATTEMPTS=200
# smtp | postmark | resend. postmark/resend send over HTTPS, so they work on hosts that
# block outbound SMTP ports (most cheap PaaS tiers) and they need no MAIL_HOST.
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@your-company.example
MAIL_OUTBOX_ENABLED=true
# How often queued mail is retried, and after how many tries it is marked failed.
MAIL_OUTBOX_POLL_MS=2000
MAIL_OUTBOX_MAX_ATTEMPTS=5
# smtp only:
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# postmark or resend only: the server/API token from your provider dashboard.
MAIL_API_KEY=
# Only needed for a region-specific or self-hosted endpoint.
MAIL_API_URL=
